# Neon Pooled Connection (e.g. postgres://...-pooler.neon.tech/...)
DATABASE_URL="postgresql://user:password@localhost:5432/watchtogether?schema=public"
# Neon Direct Connection (e.g. postgres://....neon.tech/...)
DIRECT_URL="postgresql://user:password@localhost:5432/watchtogether?schema=public"
JWT_SECRET="generate_a_secure_random_string_here"
PORT=5000
# Public URL of the web client (used for invite links and CORS; comma-separate multiple origins)
CLIENT_URL="http://localhost:5173"
# Optional SMTP settings for email invitations (in-app invites work without them)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WatchTogether <noreply@watchtogether.app>"
