# Neon Pooled Connection (e.g. postgres://...-pooler.neon.tech/...)
DATABASE_URL="postgresql://user:password@localhost:5432/watchtogether?schema=public"
# Neon Direct Connection (e.g. postgres://....neon.tech/...)
DIRECT_URL="postgresql://user:password@localhost:5432/watchtogether?schema=public"
JWT_SECRET="generate_a_secure_random_string_here"
PORT=5000
# Public URL of the web client (used for invite links and CORS; comma-separate multiple origins)
CLIENT_URL="http://localhost:5173"
# Optional SMTP settings for email invitations (in-app invites work without them)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WatchTogether <noreply@watchtogether.app>"
# Set when running behind a reverse proxy so rate limiting sees real client IPs (e.g. 1)
TRUST_PROXY=
# WebRTC relay (TURN). With TURN_SECRET the API issues short-lived credentials (coturn use-auth-secret).
TURN_URLS=
TURN_SECRET=
# Or static credentials instead of TURN_SECRET
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional comma-separated STUN servers (defaults to Google's public STUN)
STUN_URLS=
# Run several API instances: share presence, rate limits, broadcasts and room ownership via Redis (7+)
REDIS_URL=
# Optional stable id for this instance (defaults to a random id per process)
INSTANCE_ID=
# Web push (notifications with the site closed). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# In-room YouTube search. Create a key: Google Cloud Console → enable "YouTube Data API v3" → Credentials → API key.
# Free quota is 10,000 units/day; each search costs 100 (~100 searches/day), so results are cached.
YOUTUBE_API_KEY=
