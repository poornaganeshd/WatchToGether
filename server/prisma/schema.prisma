generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String
  name          String
  avatar        String?
  avatarUpdatedAt   DateTime?
  passwordChangedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  createdRooms  Room[]        @relation("HostRooms")
  participants  Participant[]
  coHostedRooms RoomCoHost[]
  messages      Message[]
  roomHistory   RoomHistoryEntry[]

  friends       Friend[]      @relation("UserFriends")
  friendOf      Friend[]      @relation("FriendUsers")
  queueItems    RoomQueueItem[]
  roomBans      RoomBan[]
  resetTokens   PasswordResetToken[]
  inviteLinks   RoomInviteLink[]
  accessGrants  RoomAccessGrant[]
  friendGroups  FriendGroup[]
  groupMemberships FriendGroupMember[]
  pushSubscriptions PushSubscription[]
  watchedVideos WatchedVideo[]
}

/// Videos a user has watched in rooms, newest first, for "Recently watched".
model WatchedVideo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  title     String?
  roomId    String?
  roomName  String?
  watchedAt DateTime @default(now())

  @@unique([userId, url])
  @@index([userId, watchedAt])
}

model Room {
  id              String        @id @default(uuid())
  displayId       String?       @unique
  name            String
  description     String?
  isPrivate       Boolean       @default(false)
  password        String?
  maxParticipants Int           @default(10)
  hostId          String
  isActive        Boolean       @default(true)
  host            User          @relation("HostRooms", fields: [hostId], references: [id])
  createdAt       DateTime      @default(now())
  
  playbackUrl     String?
  playbackTime    Float?        @default(0)
  scheduledFor    DateTime?
  reminderSentAt  DateTime?

  participants    Participant[]
  coHosts         RoomCoHost[]
  messages        Message[]
  historyEntries  RoomHistoryEntry[]
  queueItems      RoomQueueItem[]
  bans            RoomBan[]
  inviteLinks     RoomInviteLink[]
  accessGrants    RoomAccessGrant[]
}

/// Shareable links that let people into a (private) room without the password.
model RoomInviteLink {
  id            String        @id @default(uuid())
  roomId        String
  tokenHash     String        @unique
  createdById   String
  expiresAt     DateTime
  maxUses       Int?
  uses          Int           @default(0)
  revokedAt     DateTime?
  createdAt     DateTime      @default(now())

  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy     User          @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([roomId])
}

/// Granted by accepting an invite link: lets the user join without the room password.
model RoomAccessGrant {
  id            String        @id @default(uuid())
  roomId        String
  userId        String
  createdAt     DateTime      @default(now())

  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model FriendGroup {
  id            String        @id @default(uuid())
  ownerId       String
  name          String
  createdAt     DateTime      @default(now())

  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members       FriendGroupMember[]

  @@index([ownerId])
}

model FriendGroupMember {
  id            String        @id @default(uuid())
  groupId       String
  userId        String

  group         FriendGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model PushSubscription {
  id            String        @id @default(uuid())
  userId        String
  endpoint      String        @unique
  p256dh        String
  auth          String
  createdAt     DateTime      @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RoomQueueItem {
  id            String        @id @default(uuid())
  roomId        String
  url           String
  addedById     String
  position      Int
  createdAt     DateTime      @default(now())

  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  addedBy       User          @relation(fields: [addedById], references: [id], onDelete: Cascade)

  @@index([roomId, position])
}

model RoomBan {
  id            String        @id @default(uuid())
  roomId        String
  userId        String
  createdAt     DateTime      @default(now())

  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model PasswordResetToken {
  id            String        @id @default(uuid())
  userId        String
  tokenHash     String        @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime      @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoomCoHost {
  id            String        @id @default(uuid())
  roomId        String
  userId        String
  createdAt     DateTime      @default(now())

  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model Participant {
  id            String        @id @default(uuid())
  userId        String
  roomId        String
  joinedAt      DateTime      @default(now())
  
  user          User          @relation(fields: [userId], references: [id])
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
}

model RoomHistoryEntry {
  id            String        @id @default(uuid())
  userId        String
  roomId        String
  visitedAt     DateTime      @default(now())
  
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
}

model Message {
  id            String        @id @default(uuid())
  content       String
  userId        String
  roomId        String
  createdAt     DateTime      @default(now())
  /// What was playing when the message was sent, for chat replays.
  videoUrl      String?
  videoTime     Float?
  
  user          User          @relation(fields: [userId], references: [id])
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, videoUrl])
}

model Friend {
  id            String        @id @default(uuid())
  userId        String
  friendId      String
  status        String        @default("PENDING") // PENDING, ACCEPTED, BLOCKED
  createdAt     DateTime      @default(now())

  user          User          @relation("UserFriends", fields: [userId], references: [id])
  friendUser    User          @relation("FriendUsers", fields: [friendId], references: [id])

  @@unique([userId, friendId])
}
